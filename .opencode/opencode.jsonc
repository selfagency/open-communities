{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "posthog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.posthog.com/mcp"
    },
    "pocketbase": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "gaspechak-pocketbase-mcp"],
      "environment": {
        // Load credentials from environment (set in .env.local, never committed)
        "PB_URL": "${PB_URL}",
        "PB_EMAIL": "${PB_EMAIL}",
        "PB_PASSWORD": "${PB_PASSWORD}"
      }
    },
    "vite": {
      "type": "remote",
      "url": "http://localhost:5173/__mcp/sse",
      "enabled": true
    }
  }
}
