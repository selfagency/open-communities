{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "coolify": {
      "type": "remote",
      "enabled": true,
      "url": "https://host.selfagency.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:COOLIFY_HOST_TOKEN}"
      }
    },
    "posthog": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.posthog.com/mcp"
    },
    "pocketbase": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "gaspechak-pocketbase-mcp"],
      "environment": {
        "PB_URL": "{env:OPENCOMMUNITIES_API_URL}",
        "PB_TOKEN": "{env:OPENCOMMUNITIES_API_TOKEN}"
      }
    },
    "vite": {
      "type": "remote",
      "url": "http://localhost:5173/__mcp/sse",
      "enabled": false
    }
  }
}
