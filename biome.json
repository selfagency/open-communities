{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/pnpm-lock.yaml",
      "!**/package-lock.json",
      "!**/yarn.lock",
      "!**/pb_data/",
      "!**/pb_migrations/",
      "!e2e",
      "!**/build/",
      "!**/.svelte-kit/",
      "!**/node_modules/",
      "!**/npmlogs/",
      "!**/test-results/",
      "!.github/codepilot-instructions.md",
      "!src/lib/assets",
      "!src/app.css",
      "!static"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnknownProperty": "warn"
      },
      "style": {
        "noParameterAssign": "error",
        "useConst": "error",
        "useExponentiationOperator": "error",
        "useLiteralEnumMembers": "error",
        "noNonNullAssertion": "warn",
        "noExportedImports": "off",
        "noParameterProperties": "off",
        "useFilenamingConvention": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.js",
        "**/*.spec.ts",
        "**/*.spec.js",
        "**/test/**",
        "**/mocks/**",
        "**/stubs/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "complexity": {
            "noForEach": "off",
            "noCommaOperator": "off"
          },
          "correctness": {
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noShadowRestrictedNames": "off",
            "useIterableCallbackReturn": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off",
            "noUnassignedVariables": "off"
          },
          "performance": {
            "useTopLevelRegex": "off",
            "noNamespaceImport": "off"
          },
          "a11y": {
            "useButtonType": "off",
            "noLabelWithoutControl": "off",
            "useValidAriaValues": "off"
          },
          "security": {
            "noGlobalEval": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/components/**",
        "src/test/stubs/**",
        "src/routes/**/*.svelte"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noGlobalAssign": "off",
            "noShadowRestrictedNames": "off",
            "noDoubleEquals": "off",
            "noAssignInExpressions": "warn",
            "noDocumentCookie": "warn",
            "noUnassignedVariables": "off",
            "useAwait": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useTemplate": "off",
            "noRestrictedGlobals": "off",
            "noNestedTernary": "off"
          },
          "a11y": {
            "useButtonType": "off",
            "noLabelWithoutControl": "off",
            "useValidAriaValues": "off",
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off",
            "useValidAnchor": "warn",
            "noStaticElementInteractions": "warn"
          },
          "complexity": {
            "noVoid": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/svelte",
    "ultracite/biome/vitest"
  ]
}
