{
  "defaults": {
    "timeout": 30000,
    "viewport": {
      "width": 1280,
      "height": 1024
    },
    "standard": "WCAG2AA",
    "ignore": [
      "notice"
    ],
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--headless=new"]
    }
  },
  "urls": [
    "http://localhost:3000/",
    "http://localhost:3000/admin",
    "http://localhost:3000/admin/congregations",
    "http://localhost:3000/admin/pages",
    "http://localhost:3000/admin/pages/new",
    "http://localhost:3000/admin/translations",
    "http://localhost:3000/admin/users",
    "http://localhost:3000/add",
    "http://localhost:3000/contact",
    "http://localhost:3000/login"
  ]
}
