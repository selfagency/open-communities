{
  "defaults": {
    "timeout": 30000,
    "viewport": {
      "width": 1280,
      "height": 1024
    },
    "standard": "WCAG2AA",
    "ignore": [
      "notice"
    ],
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--headless=new"]
