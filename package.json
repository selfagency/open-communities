{
  "name": "open-communities",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite build",
    "build:types": "pnpx pocketbase-typegen --db ./pb_data/data.db --out ./src/lib/pocketbase.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deps:up": "docker-compose -f e2e/docker-compose.yml up -d --build",
    "deps:bootstrap": "node e2e/scripts/bootstrap.mjs",
    "deps:down": "docker-compose -f e2e/docker-compose.yml down",
    "deps:reset": "docker-compose -f e2e/docker-compose.yml down -v && docker-compose -f e2e/docker-compose.yml up -d --build && sleep 5 && node e2e/scripts/bootstrap.mjs",
    "dev": "pnpx dotenv-cli -c dynamic -- vite dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "preview": "pnpx dotenv-cli -c dynamic -- vite preview",
    "preview:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite preview",
    "start": "node build/index.js",
    "test:unit": "pnpx dotenv-cli -e .env.test -- vitest --coverage --coverage.enabled=true",
    "test:server": "pnpx dotenv-cli -e .env.test -- vitest run --project server",
    "test:browser": "pnpx dotenv-cli -e .env.test -- vitest run --project browser",
    "test:setup": "pnpx dotenv-cli -e .env.test -- node e2e/cap/setup-captcha.mjs",
    "test:e2e": "pnpx dotenv-cli -e .env.test -e .env.e2e -- playwright test --config e2e/playwright.config.mjs",
    "machine-translate": "inlang machine translate --project project.inlang",
    "test": "vitest"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.4",
    "@deck.gl/mapbox": "^9.3.4",
    "@inlang/paraglide-js": "^2.20.1",
    "@selfagency/stately": "^0.1.5",
    "isomorphic-dompurify": "^3.18.0",
    "posthog-js": "^1.393.0",
    "posthog-node": "^5.38.3",
    "svelte-reactive-preprocessor": "^0.8.3",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@faker-js/faker": "^10.5.0",
    "@html-eslint/parser": "^0.62.0",
    "@inlang/cli": "^3.1.14",
    "@inlang/paraglide-js": "2.4.0",
    "@internationalized/date": "^3.12.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lucide/svelte": "^1.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@playwright/test": "^1.61.0",
    "@poppanator/sveltekit-svg": "7.0.0",
    "@sveltejs/adapter-node": "5.5.6",
    "@sveltejs/kit": "2.67.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web": "^0.0.350",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-istanbul": "4.1.9",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "cmdk-sv": "^0.0.19",
    "concurrently": "^10.0.3",
    "cookie": "1.1.1",
    "fast-string-truncated-width": "3.0.3",
    "form-data": "^4.0.6",
    "formsnap": "2.0.1",
    "happy-dom": "^20.10.6",
    "jsdom": "29.1.1",
    "marked": "^18.0.5",
    "mode-watcher": "1.1.0",
    "msw": "^2.14.6",
    "nodemailer": "^9.0.1",
    "playwright": "^1.61.0",
    "playwright-core": "^1.61.0",
