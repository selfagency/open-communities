{
  "name": "open-communities",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/fetch-translations.mjs && vite build",
    "build:maps": "pnpm run build && pnpx @posthog/cli --dotenv-file .env.dynamic sourcemap inject --directory ./build && pnpx @posthog/cli --dotenv-file .env.dynamic sourcemap upload --directory ./build --delete-after",
    "build:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite build",
    "build:types": "pnpx pocketbase-typegen --db ./pb_data/data.db --out ./src/lib/pocketbase.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deps:up": "docker-compose -f e2e/docker-compose.yml up -d --build",
    "deps:bootstrap": "node e2e/scripts/bootstrap.mjs",
    "deps:down": "docker-compose -f e2e/docker-compose.yml down",
    "deps:reset": "docker-compose -f e2e/docker-compose.yml down -v && docker-compose -f e2e/docker-compose.yml up -d --build && sleep 5 && node e2e/scripts/bootstrap.mjs",
    "dev": "pnpx dotenv-cli -c dynamic -- vite dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "preview": "pnpx dotenv-cli -c dynamic -- vite preview",
    "preview:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite preview",
    "start": "node build/index.js",
    "test:unit": "pnpx dotenv-cli -e .env.test -- vitest --coverage --coverage.enabled=true",
    "test:server": "pnpx dotenv-cli -e .env.test -- vitest run --project server",
    "test:browser": "pnpx dotenv-cli -e .env.test -- vitest run --project browser",
    "test:setup": "pnpx dotenv-cli -e .env.test -- node e2e/cap/setup-captcha.mjs",
    "test:e2e": "pnpx dotenv-cli -e .env.test -e .env.e2e -- playwright test --config e2e/playwright.config.mjs",
    "test:e2e:dev": "PLAYWRIGHT_BASE_URL=http://localhost:5173 pnpx dotenv-cli -c dynamic -- playwright test --config e2e/playwright.config.mjs",
    "machine-translate": "inlang machine translate --project project.inlang",
    "test": "vitest"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@selfagency/stately": "^0.1.5",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "isomorphic-dompurify": "^3.18.0",
    "lexical": "^0.45.0",
    "posthog-js": "^1.393.4",
    "posthog-node": "^5.38.5",
    "stopwords-iso": "^1.1.0",
    "super-sitemap": "^1.0.12",
    "svelte-lexical": "^0.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@inlang/cli": "^3.1.14",
    "@inlang/paraglide-js": "2.4.0",
    "@internationalized/date": "^3.12.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lexical/link": "^0.45.0",
    "@lexical/list": "^0.45.0",
    "@lucide/svelte": "^1.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@playwright/test": "^1.61.1",
    "@poppanator/sveltekit-svg": "7.0.0",
    "@posthog/rollup-plugin": "^1.4.7",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.68.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tabler/icons-svelte": "^3.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/web": "^0.0.350",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-istanbul": "4.1.9",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cookie": "0.7.0",
    "fast-string-truncated-width": "3.0.3",
    "formsnap": "2.0.1",
    "happy-dom": "^20.10.6",
    "jsdom": "29.1.1",
    "layerchart": "2.0.0-next.48",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.5",
    "mode-watcher": "1.1.0",
    "msw": "^2.14.6",
    "nodemailer": "^9.0.1",
    "playwright": "^1.61.1",
    "pocketbase": "^0.27.0",
    "public-ip": "^8.0.0",
    "radashi": "12.9.1",
    "runed": "^0.37.1",
    "svelte": "5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-copy": "2.0.0",
    "svelte-maplibre": "1.3.0",
    "svelte-sonner": "1.1.1",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-helmet": "^2.1.0",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tslog": "^4.10.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.0.16",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-plugin-mcp": "^0.3.2",
    "vite-plugin-svelte-inline-component": "^0.0.8",
    "vitest": "^4.1.9",
    "vitest-browser-svelte": "^2.1.1",
    "wait-for-the-element": "^4.0.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@posthog/cli", "@tailwindcss/oxide", "core-js", "esbuild", "msw", "sqlite3"]
  },
  "packageManager": "pnpm@10.18.3",
  "jsrepo": {
    "rootDir": "src/lib/components/ui",
    "include": ["src/lib/components/ui"]
  }
}
