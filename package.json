{
  "name": "open-communities",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite build",
    "build:types": "pnpx pocketbase-typegen --db ./pb_data/data.db --out ./src/lib/pocketbase.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deps:up": "docker-compose -f e2e/docker-compose.yml up -d --build",
    "deps:down": "docker-compose -f e2e/docker-compose.yml down",
    "dev": "pnpx dotenv-cli -c dynamic -- vite dev",
    "format": "eslint --fix . && prettier --write .",
    "lint": "prettier --check . && eslint .",
    "preview": "pnpx dotenv-cli -c dynamic -- vite preview",
    "preview:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite preview",
    "start": "node build/index.js",
    "test:unit": "pnpx dotenv-cli -e .env.test -- vitest --coverage --coverage.enabled=true",
    "test:setup": "pnpx dotenv-cli -e .env.test -- node e2e/cap/setup-captcha.mjs",
    "test:e2e": "pnpx dotenv-cli -e .env.test -e .env.e2e -- playwright test --config e2e/playwright.config.mjs",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.20.0",
    "isomorphic-dompurify": "^3.18.0",
    "posthog-js": "^1.391.2",
    "posthog-node": "^5.38.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/css": "^1.3.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.62.0",
    "@html-eslint/parser": "^0.62.0",
    "@inlang/cli": "^3.1.14",
    "@inlang/paraglide-js": "2.4.0",
    "@internationalized/date": "^3.12.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lucide/svelte": "^1.21.0",
    "@nanostores/persistent": "1.3.4",
    "@playwright/test": "^1.61.0",
    "@poppanator/sveltekit-svg": "7.0.0",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web": "^0.0.350",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-istanbul": "4.1.9",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "cmdk-sv": "^0.0.19",
    "concurrently": "^10.0.3",
    "cookie": "1.1.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-svelte": "3.19.0",
    "fast-string-truncated-width": "3.0.3",
    "form-data": "^4.0.6",
    "formsnap": "2.0.1",
    "globals": "17.6.0",
    "happy-dom": "^20.10.6",
    "jsdom": "29.1.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.5",
    "mode-watcher": "1.1.0",
    "nanostores": "1.3.0",
    "nodemailer": "^9.0.1",
    "pocketbase": "^0.27.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "public-ip": "^8.0.0",
    "radashi": "12.9.1",
    "sqlite3": "^6.0.1",
    "svelte": "5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-copy": "2.0.0",
    "svelte-maplibre": "1.3.0",
    "svelte-sonner": "1.1.1",
    "sveltekit-helmet": "^2.1.0",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-csstree": "^0.3.3",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "tslog": "^4.10.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-plugin-mcp": "^0.3.2",
    "vite-plugin-svelte-inline-component": "^0.0.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "vitest-browser-svelte": "^2.1.1",
    "wait-for-the-element": "^4.0.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js",
      "esbuild",
      "sqlite3"
    ]
  },
  "packageManager": "pnpm@10.18.3"
}
