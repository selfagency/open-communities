		"eslint-plugin-html": "^8.1.3",
		"eslint-plugin-perfectionist": "^4.15.1",
		"eslint-plugin-svelte": "3.12.4",
		"fast-string-truncated-width": "3.0.3",
		"form-data": "^4.0.4",
		"formsnap": "2.0.1",
		"globals": "16.4.0",
		"happy-dom": "^18.0.1",
		"jsdom": "27.0.1",
		"lucide-svelte": "^0.546.0",
		"marked": "^16.4.1",
		"mode-watcher": "1.1.0",
