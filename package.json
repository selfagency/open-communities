    "svelte": "5.56.3",
    "svelte-check": "^4.7.0",
    "svelte-copy": "2.0.0",
    "svelte-maplibre": "1.3.0",
    "svelte-sonner": "1.1.1",
    "sveltekit-helmet": "^2.1.0",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "tslog": "^4.10.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-plugin-mcp": "^0.3.2",
    "vite-plugin-svelte-inline-component": "^0.0.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "vitest-browser-svelte": "^2.1.1",
    "wait-for-the-element": "^4.0.2",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@tailwindcss/oxide", "core-js", "esbuild", "sqlite3"]
  },
  "packageManager": "pnpm@10.18.3"
}
