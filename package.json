		"tailwind-variants": "3.1.1",
		"tailwindcss": "^4.1.14",
		"tailwindcss-animate": "^1.0.7",
		"tslib": "^2.8.1",
		"tslog": "^4.10.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^6",
