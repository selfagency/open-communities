		"vite-plugin-mcp": "^0.2.4",
		"vite-plugin-svelte-inline-component": "^0.0.8",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0",
		"wait-for-the-element": "^4.0.2",
		"zod": "4.1.12"
	},
	"engines": {
		"node": "20"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"core-js",
			"esbuild",
			"sqlite3"
		]
	},
	"packageManager": "pnpm@10.18.3"
}