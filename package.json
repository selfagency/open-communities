{
	"name": "open-communities",
	"version": "1.0.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite build",
		"build:types": "pnpx pocketbase-typegen --db ./pb_data/data.db --out ./src/lib/pocketbase.d.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deps:up": "docker-compose -f e2e/docker-compose.yml up -d --build",
		"deps:down": "docker-compose -f e2e/docker-compose.yml down",
		"dev": "pnpx dotenv-cli -c dynamic -- vite dev",
		"format": "eslint --fix . && prettier --write .",
		"lint": "prettier --check . && eslint .",
		"preview": "pnpx dotenv-cli -c dynamic -- vite preview",
		"preview:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite preview",
		"start": "node build/index.js",
		"test:unit": "pnpx dotenv-cli -e .env.test -- vitest --coverage --coverage.enabled=true",
		"test:setup": "pnpx dotenv-cli -e .env.test -- node e2e/cap/setup-captcha.mjs",
		"test:e2e": "pnpx dotenv-cli -e .env.test -e .env.e2e -- playwright test --config e2e/playwright.config.mjs",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.4.0",
		"posthog-js": "^1.276.0",
		"posthog-node": "^5.10.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/css": "^0.13.0",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.38.0",
		"@html-eslint/eslint-plugin": "^0.47.0",
		"@html-eslint/parser": "^0.47.0",
		"@inlang/cli": "^3.0.12",
		"@inlang/paraglide-js": "2.4.0",
		"@internationalized/date": "^3.10.0",
		"@leeoniya/ufuzzy": "^1.0.19",
		"@lucide/svelte": "^0.546.0",
		"@nanostores/persistent": "1.1.0",
		"@playwright/test": "^1.56.1",
		"@poppanator/sveltekit-svg": "6.0.0",
		"@sveltejs/adapter-node": "5.4.0",
		"@sveltejs/kit": "2.47.1",
		"@sveltejs/vite-plugin-svelte": "^5",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.1",
		"@types/eslint": "^9.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.19.9",
		"@types/nodemailer": "^7.0.2",
		"@types/web": "^0.0.281",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-istanbul": "3.2.4",
		"bits-ui": "2.14.0",
		"clsx": "^2.1.1",
		"cmdk-sv": "^0.0.19",
		"concurrently": "^9.2.1",
		"cookie": "1.0.2",
		"eslint": "^9.38.0",
