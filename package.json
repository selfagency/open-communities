{
  "name": "open-communities",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:maps": "pnpm run build:prod && pnpx @posthog/cli --dotenv-file .env.dynamic sourcemap inject --directory ./build && pnpx @posthog/cli --dotenv-file .env.dynamic sourcemap upload --directory ./build --delete-after",
    "build:prod": "node scripts/sync-translations.mjs && node scripts/fetch-translations.mjs && pnpm paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && node scripts/fix-paraglide-export.mjs && vite build",
    "build:test": "node scripts/fetch-translations.mjs && pnpx dotenv-cli -e .env.test -e .env.e2e -- vite build",
    "build:types": "pocketbase-typegen --db ./docker/pocketbase/pb_data/data.db --out ./src/lib/pocketbase.d.ts",
    "check": "ultracite check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deps:bootstrap": "node docker/scripts/bootstrap.mjs",
    "deps:down": "docker compose --env-file .env.dynamic -f docker/docker-compose.yml -f docker/docker-compose.dev.yml down",
    "deps:reset": "docker compose --env-file .env.dynamic -f docker/docker-compose.yml -f docker/docker-compose.dev.yml down -v && rm -rf docker/pocketbase/pb_data && mkdir -p docker/pocketbase/pb_data && sed -i '' '/^CAPTCHA_INTERNAL_ENDPOINT=/d; /^PUBLIC_CAPTCHA_SITE_KEY=/d; /^CAPTCHA_SITE_SECRET=/d; /^# Created by bootstrap/d' .env.dynamic .env.e2e 2>/dev/null; docker compose --env-file .env.dynamic -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d --build pocketbase dragonfly cap libretranslate mailpit && sleep 5 && node docker/scripts/bootstrap.mjs",
    "deps:up": "docker compose --env-file .env.dynamic -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d --build pocketbase dragonfly cap libretranslate mailpit",
    "deps:verify-hooks": "node docker/scripts/verify-hooks.mjs",
    "dev": "pnpx dotenv-cli -c dynamic -- vite dev",
    "fix": "ultracite fix",
    "machine-translate": "inlang machine translate --project project.inlang",
    "prepare": "husky",
    "preview": "pnpx dotenv-cli -c dynamic -- vite preview",
    "preview:test": "pnpx dotenv-cli -e .env.test -e .env.e2e -- vite preview",
    "start": "node build/index.js",
    "svelte-check": "svelte-kit sync && svelte-check --tsgo --incremental --tsconfig ./tsconfig.json",
    "sync:translations": "node scripts/sync-translations.mjs",
    "test": "vitest --run",
    "test:a11y": "vitest run --project browser src/lib/components/global/header.test.ts",
    "test:browser": "pnpx dotenv-cli -e .env.test -- vitest --run --project browser",
    "test:e2e": "pnpx dotenv-cli -e .env.test -e .env.e2e -- playwright test --config e2e/playwright.config.cjs",
    "test:e2e:dev": "PLAYWRIGHT_BASE_URL=http://localhost:5173 pnpx dotenv-cli -c dynamic -- playwright test --config e2e/playwright.config.cjs",
    "test:server": "pnpx dotenv-cli -e .env.test -- vitest --run --project server",
    "test:setup": "pnpx dotenv-cli -e .env.test -- node e2e/cap/setup-captcha.mjs",
    "test:unit": "pnpx dotenv-cli -e .env.test -- vitest --run --project server --coverage"
  },
  "dependencies": {
    "@jsrob/svelte-portal": "^0.2.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@math.gl/types": "^4.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@selfagency/stately": "^0.1.6",
    "@sveltejs/kit": "2.70.2",
    "@tabler/icons-svelte": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/table-core": "^8.21.3",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "fast-string-truncated-width": "3.0.3",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "^3.22.0",
    "mailgun.js": "^14.0.0",
    "marked": "^18.0.9",
    "mode-watcher": "1.1.0",
    "pocketbase": "^0.27.3",
    "posthog-js": "^1.417.0",
    "posthog-node": "^5.49.0",
    "public-ip": "^8.0.0",
    "radashi": "12.9.1",
    "stopwords-iso": "^1.1.0",
    "suneditor": "^3.3.0",
    "super-sitemap": "^2.0.6",
    "svelte": "5.56.9",
    "svelte-copy": "2.0.0",
    "svelte-maplibre": "2.0.0",
    "svelte-sonner": "1.1.1",
    "sveltekit-helmet": "^2.1.0",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.3",
    "tslog": "^4.11.0",
    "wait-for-the-element": "^4.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@accesslint/core": "^0.21.0",
    "@accesslint/vitest": "^0.3.2",
    "@biomejs/biome": "2.5.8",
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.2",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@playwright/test": "^1.62.1",
    "@poppanator/sveltekit-svg": "7.0.1",
    "@posthog/rollup-plugin": "^1.4.8",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/cookie": "^1.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web": "^0.0.354",
    "@typescript/native-preview": "7.0.0-dev.20260624.1",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "concurrently": "^10.0.4",
    "cookie": "1.1.1",
    "fallow": "^3.15.0",
    "formsnap": "2.0.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "layerchart": "2.2.0",
    "lint-staged": "^17.3.0",
    "maplibre-gl": "^6.3.0",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "pocketbase-jsvm": "^0.25.10001",
    "pocketbase-typegen": "^1.5.0",
    "runed": "^0.37.1",
    "svelte-check": "^4.7.6",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "ultracite": "7.10.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.2.1",
    "vite-plugin-biome": "^1.2.0",
    "vite-plugin-devtools-json": "1.1.0",
    "vite-plugin-mcp": "^0.3.2",
    "vite-plugin-svelte-inline-component": "^0.0.8",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "3.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@posthog/cli",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "msw",
      "protobufjs",
      "puppeteer",
      "sqlite3"
    ]
  }
}
